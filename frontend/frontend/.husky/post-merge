#!/bin/sh
if git diff --name-only HEAD@{1} HEAD | grep -q "package-lock.json"; then
  echo "package-lock.json cambió al hacer merge, corriendo npm install..."
  if [ -d "frontend/frontend" ]; then
    npm --prefix frontend/frontend install
  elif [ -d "frontend" ]; then
    npm --prefix frontend install
  else
    npm install
  fi
fi
